      "addressed": true,
      "path": "packages/reflex-base/src/reflex_base/utils/log.py",
      "outdated": true
    },
    {
      "by": "greptile-apps",
      "ask": "Stopped descendants delay exit: `_alive` counts a zombie as running because `os.kill(pid, 0)` still succeeds for it.",
      "addressed": true,
      "path": "packages/reflex-base/src/reflex_base/utils/process_tree.py",
      "outdated": false
    },
    {
